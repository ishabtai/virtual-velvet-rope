  "coalitions": [
    {
      "id": "change-plus-arab-support",
      "label": "ממשלת שינוי בתמיכת המפלגות הערביות",
      "members": [
        "yashar",
        "byachad",
        "democrats",
        "yisrael-beiteinu",
        "reservists",
        "joint-list",
        "raam"
      ],
      "probability": 0.8854,
      "meanSeats": 66.1441,
      "plausibility": 0.45,
      "reasoning": "תמיכה מבחוץ או שותפות מלאה של חד\"ש–תע\"ל ורע\"מ. תקדים ממשלת בנט–לפיד (2021) מוכיח שזה אפשרי עם רע\"מ, אך ליברמן וחלק מישר הביעו הסתייגות, וחד\"ש–תע\"ל עצמה סירבה היסטורית להיכנס לקואליציה. הסתברות פוליטית בינונית — ולכן היא מוצגת בנפרד ולא מוזגת לתרחיש הגוש."
    },
    {
      "id": "unity-without-netanyahu",
      "label": "ממשלת אחדות — ליכוד ללא נתניהו",
      "members": [
        "likud",
        "yashar",
        "byachad",
        "yisrael-beiteinu"
      ],
      "probability": 0.83135,
      "meanSeats": 63.9997,
      "plausibility": 0.25,
      "reasoning": "תרחיש שנפתח רק אם הליכוד מחליף מנהיגות אחרי הבחירות. איזנקוט וליברמן לא פסלו ישיבה עם הליכוד — הם פסלו ישיבה עם נתניהו. אריתמטית זו אחת הקואליציות הקלות ביותר להרכבה; פוליטית היא דורשת אירוע שטרם קרה."
    },
    {
      "id": "change-bloc",
      "label": "ממשלת שינוי — ללא המפלגות הערביות",
      "members": [
        "yashar",
        "byachad",
        "democrats",
        "yisrael-beiteinu",
        "reservists"
      ],
      "probability": 0.08295,
      "meanSeats": 54.26285,
      "plausibility": 0.9,
      "reasoning": "ישר, ביחד, הדמוקרטים, ישראל ביתנו והמילואימניקים. זו הקואליציה שאיזנקוט מכוון אליה במפורש. החיכוך הפנימי — ליברמן מול גולן בנושאי דת ומדינה — משמעותי אך פחות מהמשותף: הסכמה על החלפת נתניהו. תלויה קריטית בשאלה אם הנדל–זליכה חוצים את אחוז החסימה."
    },
    {
      "id": "netanyahu-bloc",
      "label": "ממשלת נתניהו — הגוש הנוכחי",
      "members": [
        "likud",
        "shas",
        "utj",
        "otzma",
        "religious-zionism",
        "amcha"
      ],
      "probability": 0.07795,
      "meanSeats": 53.8559,
      "plausibility": 0.95,
      "reasoning": "הקואליציה היוצאת בתוספת 'עמך ישראל' של וינטר. כל המפלגות בגוש הצהירו על תמיכה בנתניהו לראשות הממשלה, ולכן אם האריתמטיקה מסתדרת — הממשלה קמה. הסיכון העיקרי אינו פוליטי אלא חשבוני: הציונות הדתית–זהות ועמך ישראל מרחפות סביב אחוז החסימה, וכישלון של אחת מהן מוחק ארבעה מנדטים מהגוש."
    },
    {
      "id": "grand-coalition",
      "label": "ממשלת אחדות רחבה — ליכוד וישר",
      "members": [
        "likud",
        "yashar"
      ],
      "probability": 0,
      "meanSeats": 44.64635,
      "plausibility": 0.12,
      "reasoning": "שתי המפלגות הגדולות בלבד. חוסמת מבוי סתום אך דורשת מאיזנקוט לחזור בו מהתחייבותו המרכזית. מוצגת כי האריתמטיקה שלה כמעט תמיד עובדת — וזו בדיוק הסיבה לא להסיק ממנה מסקנות."
    }
