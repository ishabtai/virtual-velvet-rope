  "coalitions": [
    {
      "id": "change-plus-arab-support",
      "label": "ממשלת שינוי בתמיכת המפלגות הערביות",
      "members": [
        "yashar",
        "byachad",
        "democrats",
        "yisrael-beiteinu",
        "reservists",
        "joint-list",
        "raam"
